# Copy this file to .env.migration and fill in both PostgreSQL URLs.
# SOURCE_DATABASE_URL is the existing database that contains your data.
# TARGET_DATABASE_URL is the new Supabase database (use Direct or Session pooler,
# not the transaction pooler used by the deployed app).
SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
TARGET_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
