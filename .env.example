# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma/schema.prisma` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Supabase Postgres connection string. Copy it from your Supabase project:
# Dashboard > Connect > Session pooler (or Direct connection if your network supports IPv6).
# This must be a PostgreSQL connection string beginning with postgresql://, not the project URL or an API key.
# Keep this URL private. URL-encode special characters in your database password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"

# Server-side Supabase Storage for product and admin-uploaded images.
# Create a public bucket with this name in Supabase Storage.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_STORAGE_BUCKET="product-images"

# Secret key for JWT verification (used in admin authentication)
# Generate a random strong string for production (e.g., using `openssl rand -base64 32`)
JWT_SECRET="your-super-secret-jwt-key"

# SMTP Configuration for Email Service (Required for Admin Recovery Flows)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-security-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Mahadev Admin <your-security-gmail@gmail.com>"
